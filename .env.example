# Copy to .env and change the password. .env is gitignored; never commit real values.
POSTGRES_PASSWORD=change-me
OLLAMA_HOST=http://127.0.0.1:11434
NGO_CHAT_MODEL=llama3.2:1b
NGO_EMBED_MODEL=bge-m3
DATABASE_URL=postgresql://ngo:change-me@127.0.0.1:5432/ngo
# Ollama's CPU default is 4096 tokens, which silently truncates RAG prompts.
# Variants A and B must use the same value.
OLLAMA_CONTEXT_LENGTH=8192
