{"case_id": "con-01", "claims": [{"source_id": "eea-ghg-trends-2024", "quote": "Current GHG projections, as reported by Member States, suggest that a 49% reduction in net emissions will be reached by 2030 compared to 1990 levels", "supports": "49% in 2024 edition", "start": 532, "end": 680, "sha256": "d16b049abf8299289a8e8a9fb49fd630fb303a5fa1b7ff1475d12be19eedee89", "numbers": ["49", "2030", "1990"]}, {"source_id": "eea-ghg-trends-2024", "quote": "Published 31 Oct 2024", "supports": "2024 edition date", "start": 1021, "end": 1042, "sha256": "08f0805b6097ca6a6eaf2a2250e92a87fee58b1540d5cfa3754624e8801fd5f9", "numbers": ["31", "2024"]}, {"source_id": "eea-ghg-trends-2025", "quote": "Projections based on current policies and measures reported by Member States suggest that a 47% reduction in net emissions will be reached by 2030 compared to 1990 levels.", "supports": "47% in 2025", "start": 1469, "end": 1640, "sha256": "7fddb2872f73900e849ded3af626414fef7b9dfb493afd1288cd96aeaddc6f99", "numbers": ["47", "2030", "1990"]}, {"source_id": "eea-ghg-trends-2025", "quote": "putting the EU at a projected 54% reduction by 2030 compared to 1990 levels", "supports": "54% with planned measures", "start": 1741, "end": 1816, "sha256": "f1690b3cd94484559fc7eee280633e5fc5f678b518a95558a6a7e1fd7890b094", "numbers": ["54", "2030", "1990"]}, {"source_id": "eea-ghg-trends-2025", "quote": "Published 06 Nov 2025", "supports": "2025 edition date", "start": 1201, "end": 1222, "sha256": "168070b3e1143f79422b97927e91f7a128ebd2171d8c4765a75eb59e13695193", "numbers": ["06", "2025"]}, {"source_id": "eea-ghg-trends-2024", "quote": "the policies and measures currently in place combined would achieve a reduction of 43% in", "supports": "43% existing measures, 2024", "start": 3978, "end": 4067, "sha256": "775a41cd099e00298e505012827f493f29d0a6328e993881b24c579b4d137634", "numbers": ["43"]}, {"source_id": "eea-ghg-trends-2024", "quote": "The projected reduction would reach 49% when planned additional measures are taken into account", "supports": "49% additional measures, 2024", "start": 4114, "end": 4209, "sha256": "21877bc4141a80359163bba3ca5775aa91ecc98131420ce9447433a93895b400", "numbers": ["49"]}, {"source_id": "eea-ghg-trends-2025", "quote": "policies and measures currently in place would achieve a reduction of 47% in net emission levels by 2030 compared to 1990", "supports": "47% existing measures, 2025", "start": 3806, "end": 3927, "sha256": "0435802e7bcfe661b27006eac15aa1ef05900fb68791723ca083a6ef2b255937", "numbers": ["47", "2030", "1990"]}, {"source_id": "eea-ghg-trends-2025", "quote": "The projected reduction would reach 54% when planned additional measures are taken into account, leaving a one-percentage point gap towards the 55% target", "supports": "54% additional measures and 1-point gap, 2025", "start": 3929, "end": 4083, "sha256": "139f1caa37a6b4fd9fbc0bafad75259f85da7b030a818842d4df7fff9d236e0e", "numbers": ["54", "55"]}], "absence_terms": []}
